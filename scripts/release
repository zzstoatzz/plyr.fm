#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""create a github release using timestamp-based versioning

version format: YYYY.MMDD.HHMMSS (e.g., 2025.1106.134523)

usage:
    just release
    ./scripts/release
"""

import argparse
import subprocess
import sys
from datetime import UTC, datetime


def production_promotion(target: str, *, reconcile: bool = False) -> str:
    production = subprocess.check_output(
        ["git", "rev-parse", "origin/production-fe"], text=True
    ).strip()
    ancestor = subprocess.run(
        ["git", "merge-base", "--is-ancestor", production, target], check=False
    )
    if ancestor.returncode == 0:
        return target
    if ancestor.returncode != 1:
        raise RuntimeError("could not inspect production history")
    if not reconcile:
        raise RuntimeError(
            "production-fe has divergent history; review git diff "
            "origin/production-fe origin/main, then use --reconcile-production-history "
            "to promote exactly main's tree while retaining both histories"
        )
    tree = subprocess.check_output(
        ["git", "rev-parse", f"{target}^{{tree}}"], text=True
    ).strip()
    return subprocess.check_output(
        ["git", "commit-tree", tree, "-p", production, "-p", target],
        input="release: promote reviewed main preserving production history\n",
        text=True,
    ).strip()


def main() -> int:
    """create release with timestamp version."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--reconcile-production-history", action="store_true")
    args = parser.parse_args()

    # HEAD must be origin/main; the local `main` branch is never required
    subprocess.run(["git", "fetch", "origin"], capture_output=True, check=True)
    head, remote_main = (
        subprocess.run(
            ["git", "rev-parse", ref], capture_output=True, text=True, check=True
        ).stdout.strip()
        for ref in ("HEAD", "origin/main")
    )
    if head != remote_main:
        print(f"❌ HEAD ({head[:8]}) is not origin/main ({remote_main[:8]})")
        print("   run: git switch --detach origin/main")
        return 1

    # ensure working directory is clean
    result = subprocess.run(
        ["git", "status", "--porcelain"],
        capture_output=True,
        text=True,
        check=True,
    )
    if result.stdout.strip():
        print("❌ working directory has uncommitted changes")
        return 1

    # check if there are backend changes since last release
    result = subprocess.run(
        ["gh", "release", "list", "--limit", "1"],
        capture_output=True,
        text=True,
        check=True,
    )
    if result.stdout.strip():
        last_release = result.stdout.split()[0]

        # check for backend changes since last release
        result = subprocess.run(
            # scripts/costs rides releases too: the hourly export-costs workflow
            # checks out the latest release tag (#1166), so a costs-script fix
            # only takes effect once a release includes it.
            [
                "git",
                "log",
                f"{last_release}..HEAD",
                "--oneline",
                "--",
                "backend/src/backend/",
                "backend/alembic/",
                "backend/alembic.ini",
                "backend/pyproject.toml",
                "backend/uv.lock",
                "backend/Dockerfile",
                "lexicons/",
                "README.md",
                "scripts/costs/",
            ],
            capture_output=True,
            text=True,
            check=True,
        )

        if not result.stdout.strip():
            print("❌ no backend changes since last release")
            print(f"   last release: {last_release}")
            print("   only frontend/docs changes do not require a backend release")
            return 1

    try:
        promotion = production_promotion(
            remote_main, reconcile=args.reconcile_production_history
        )
    except RuntimeError as exc:
        print(f"❌ {exc}")
        return 1

    version = datetime.now(UTC).strftime("%Y.%m%d.%H%M%S")

    # print banner using figlet
    subprocess.run(["figlet", "-f", "small", "plyr.fm"], check=False)
    print("───────────────────────────")
    print(f"release  {version}")
    print("target   production")
    print("───────────────────────────")

    # create release - gh will auto-generate notes from commits
    subprocess.run(
        [
            "gh",
            "release",
            "create",
            version,
            "--title",
            version,
            "--generate-notes",
            "--target",
            remote_main,
        ],
        check=True,
    )

    print(f"\n✓ release {version} created")
    print("✓ production backend deployment starting...")

    # A plain push rejects any concurrent divergent production promotion.
    print("\n🔄 updating production-fe branch...")
    subprocess.run(
        ["git", "push", "origin", f"{promotion}:refs/heads/production-fe"], check=True
    )

    print("✓ production frontend deployment starting...")

    # mirror to tangled
    subprocess.run(
        ["git", "push", "tangled", f"{remote_main}:refs/heads/main", "--tags"],
        check=True,
    )
    print("✓ mirrored to tangled")

    return 0


if __name__ == "__main__":
    sys.exit(main())
