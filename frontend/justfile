set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
default := "run"

alias r := run
alias dev := run

# run frontend dev server (hot reloads)
run:
    bun run dev --host 0.0.0.0

# check svelte types
check:
    bun run check

# run component tests (jsdom, fast — no browser)
test:
    bun run test

# accessibility gate: render every story in chromium, fail on axe violations
# (needs `bunx playwright install chromium` once)
test-storybook:
    PUBLIC_API_URL="${PUBLIC_API_URL:-https://api.plyr.fm}" bun run test-storybook

# preview components in isolation (storybook, http://localhost:6006)
storybook:
    bun run storybook

# build the static storybook (used to sanity-check stories in CI)
build-storybook:
    PUBLIC_API_URL="${PUBLIC_API_URL:-https://api.plyr.fm}" bun run build-storybook

# check the existing Svelte app against the Zig v1 canary API contract
check-next:
    PUBLIC_API_URL=https://next.plyr.fm/api VITE_API_GENERATION=zig-v1 VITE_ZIG_API_ORIGIN=https://plyr-api-zig-canary.fly.dev VITE_APP_CANONICAL_HOST=next.plyr.fm VITE_APP_CANONICAL_URL=https://next.plyr.fm bun run check

# build the existing Svelte app for next.plyr.fm
build-next:
    PUBLIC_API_URL=https://next.plyr.fm/api VITE_API_GENERATION=zig-v1 VITE_ZIG_API_ORIGIN=https://plyr-api-zig-canary.fly.dev VITE_APP_CANONICAL_HOST=next.plyr.fm VITE_APP_CANONICAL_URL=https://next.plyr.fm bun run build

# manually publish the current branch to the isolated next Pages project
deploy-next:
    ./scripts/deploy-next
