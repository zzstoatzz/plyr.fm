{
  "lexicon": 1,
  "id": "fm.plyr.getTopTracks",
  "defs": {
    "main": {
      "type": "query",
      "description": "The most liked public tracks over a period, most liked in the period first. No auth required; results are not personalized.",
      "parameters": {
        "type": "params",
        "properties": {
          "period": {
            "type": "string",
            "knownValues": [
              "day",
              "week",
              "month",
              "all"
            ],
            "default": "all",
            "maxLength": 32,
            "description": "Window for counting likes: the last day, week or month, or all time."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "tracks"
          ],
          "properties": {
            "tracks": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#topTrack"
              }
            }
          }
        }
      }
    },
    "topTrack": {
      "type": "object",
      "required": [
        "track",
        "likeCount"
      ],
      "properties": {
        "track": {
          "type": "ref",
          "ref": "fm.plyr.defs#trackView"
        },
        "likeCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Likes the track received in the period; the ranking key."
        }
      }
    }
  }
}
