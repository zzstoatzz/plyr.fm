{
  "lexicon": 1,
  "id": "fm.plyr.getTopTracks",
  "defs": {
    "main": {
      "type": "query",
      "description": "The most liked public tracks over a period, most liked first. No auth required.",
      "parameters": {
        "type": "params",
        "properties": {
          "period": { "type": "string", "knownValues": ["day", "week", "month", "all_time"], "default": "all_time", "maxLength": 32 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["tracks"],
          "properties": {
            "tracks": { "type": "array", "items": { "type": "ref", "ref": "fm.plyr.defs#trackView" } }
          }
        }
      }
    }
  }
}
