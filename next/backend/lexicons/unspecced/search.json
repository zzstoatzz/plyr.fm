{
  "lexicon": 1,
  "id": "fm.plyr.unspecced.search",
  "defs": {
    "main": {
      "type": "query",
      "description": "Tracks, artists, albums and playlists matching a query. The response body is the appview's own JSON shape, not yet specified here.",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "types": {
            "type": "string",
            "description": "Comma-separated: track, artist, album, playlist."
          }
        },
        "required": [
          "q"
        ]
      },
      "output": {
        "encoding": "application/json"
      }
    }
  }
}
