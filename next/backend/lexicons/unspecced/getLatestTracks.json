{
  "lexicon": 1,
  "id": "fm.plyr.unspecced.getLatestTracks",
  "defs": {
    "main": {
      "type": "query",
      "description": "The newest public tracks in discovery, newest first. Tracks tagged as AI-generated are left out, as on the plyr.fm home feed. No auth required; results are not personalized.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "tracks"
          ],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "tracks": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "fm.plyr.unspecced.defs#trackView"
              }
            }
          }
        }
      }
    }
  }
}
