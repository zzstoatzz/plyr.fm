{
  "lexicon": 1,
  "id": "fm.plyr.unspecced.listPlaylists",
  "defs": {
    "main": {
      "type": "query",
      "description": "Playlists, newest first, optionally one account's. The response body is the appview's own JSON shape, not yet specified here.",
      "parameters": {
        "type": "params",
        "properties": {
          "ownerDid": {
            "type": "string",
            "format": "did",
            "description": "The playlist owner."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json"
      }
    }
  }
}
