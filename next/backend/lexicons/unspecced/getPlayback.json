{
  "lexicon": 1,
  "id": "fm.plyr.unspecced.getPlayback",
  "defs": {
    "main": {
      "type": "query",
      "description": "Where and whether a track's audio can be played: a delivery URL, or the space a closed track's audio is in. The response body is the appview's own JSON shape, not yet specified here.",
      "parameters": {
        "type": "params",
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the fm.plyr.track record."
          }
        },
        "required": [
          "uri"
        ]
      },
      "output": {
        "encoding": "application/json"
      }
    }
  }
}
