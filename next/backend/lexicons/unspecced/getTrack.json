{
  "lexicon": 1,
  "id": "fm.plyr.unspecced.getTrack",
  "defs": {
    "main": {
      "type": "query",
      "description": "One track. Name it by uri, or by legacyId for a numeric ID from a production plyr.fm link. The response body is the appview's own JSON shape, not yet specified here.",
      "parameters": {
        "type": "params",
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT-URI of the fm.plyr.track record."
          },
          "legacyId": {
            "type": "integer",
            "minimum": 1,
            "description": "Production plyr.fm track ID."
          }
        }
      },
      "output": {
        "encoding": "application/json"
      }
    }
  }
}
