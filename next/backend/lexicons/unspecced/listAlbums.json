{
  "lexicon": 1,
  "id": "fm.plyr.unspecced.listAlbums",
  "defs": {
    "main": {
      "type": "query",
      "description": "An artist's albums, newest first. The response body is the appview's own JSON shape, not yet specified here.",
      "parameters": {
        "type": "params",
        "properties": {
          "artistDid": {
            "type": "string",
            "format": "did",
            "description": "The album owner."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "artistDid"
        ]
      },
      "output": {
        "encoding": "application/json"
      }
    }
  }
}
