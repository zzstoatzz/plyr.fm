.{
    .{
        .name = "a percent escape takes a sign",
        .file = "src/internal/http/query.zig",
        .old = "const high = std.fmt.charToDigit(digits[0], 16) catch return null;\n    const low = std.fmt.charToDigit(digits[1], 16) catch return null;\n    return high * 16 + low;",
        .new = "return std.fmt.parseInt(u8, digits, 16) catch null;",
    },
    .{
        .name = "a raw NUL passes a path segment",
        .file = "src/internal/http/path_segment.zig",
        .old = "\"/\\\\\\x00\"",
        .new = "\"/\\\\\"",
    },
    .{
        .name = "a decimal parameter takes separators",
        .file = "src/internal/http/query.zig",
        .old = "for (text) |c| if (!std.ascii.isDigit(c)) return error.InvalidCharacter;",
        .new = "",
    },
    .{
        .name = "a DID-authority AT-URI is not a uri",
        .file = "src/internal/atproto/lexicon_value.zig",
        .old = "return atprotoUriSyntax(value);",
        .new = "return false;",
    },
    .{
        .name = "a full page claims no more",
        .file = "src/internal/application/list_tracks.zig",
        .old = "const has_more = items.len > options.limit;",
        .new = "const has_more = items.len > options.limit + 1;",
    },
    .{
        .name = "a cursor skips its uri check",
        .file = "src/internal/identity/record_cursor.zig",
        .old = "    const at_uri = raw[header_bytes..];\n    try validateRecordUri(at_uri);",
        .new = "    const at_uri = raw[header_bytes..];",
    },
    .{
        .name = "a regional indicator pair splits",
        .file = "src/internal/text/grapheme.zig",
        .old = "return ri_count % 2 == 0;",
        .new = "return ri_count % 2 == 1;",
    },
    .{
        .name = "await backoff has no cap",
        .file = "src/internal/application/await_record.zig",
        .old = "const step: u64 = @min(doubled, max_poll_ms);",
        .new = "const step: u64 = doubled;",
    },
    .{
        .name = "like counts ignore availability changes",
        .file = "migrations/0030_like_counts_statement_triggers.sql",
        .old = "AFTER INSERT OR DELETE OR UPDATE OF available ON plyr_index.account_availability",
        .new = "AFTER DELETE ON plyr_index.account_availability",
    },
    .{
        .name = "a retargeted like keeps counting its old subject",
        .file = "migrations/0030_like_counts_statement_triggers.sql",
        .old = "FROM old_rows WHERE subject_uri IS NOT NULL\n              UNION",
        .new = "FROM old_rows WHERE false\n              UNION",
    },
    .{
        .name = "a jam command applies against a stale revision",
        .file = "src/internal/jams/model.zig",
        .old = "if (command.expectedRevision != state.revision or state.revision >= max_counter",
        .new = "if (state.revision >= max_counter",
    },
    .{
        .name = "a jam guest can seek",
        .file = "src/internal/jams/model.zig",
        .old = "if (command.action == .seek and !std.mem.eql(u8, actor_did, host_did))",
        .new = "if (command.action == .seek and false)",
    },
    .{
        .name = "a selected jam track resumes the old position",
        .file = "src/internal/jams/model.zig",
        .old = "next.index = command.index.?;\n            next.playing = command.playing orelse state.playing;\n            if (next.index != state.index) {\n                next.occurrence += 1;\n                next.positionMs = 0;",
        .new = "next.index = command.index.?;\n            next.playing = command.playing orelse state.playing;\n            if (next.index != state.index) {\n                next.occurrence += 1;",
    },
    .{
        .name = "a playing jam runs past the end of the track",
        .file = "src/internal/jams/model.zig",
        .old = "return @min(state.queue[state.index].durationMs, state.positionMs +| elapsed);",
        .new = "return state.positionMs +| elapsed;",
    },
}
