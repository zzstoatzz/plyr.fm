// scripts/campaign wraps hegel-campaign; commands run in next/backend.
// "stores" and "calibration" need the disposable zig_test database that
// .github/workflows/test-zig.yml provides on port 5435.
.{
    .version = 1,
    .campaigns = .{
        .{
            .name = "parsers",
            .root = "next/backend",
            .build = .{ "zig", "build", "install-fuzz", "-Dhegel", "-Doptimize=ReleaseSafe" },
            .command = .{"zig-out/bin/fuzz"},
            .seeds = .{ 1, 2 },
            .cases = 200,
            .timeout_seconds = 900,
            .reach = .{
                .{ .key = "identity.id_round_trip", .event = "uri refused" },
                .{ .key = "identity.id_round_trip", .event = "uri accepted" },
                .{ .key = "identity.id_canonical", .event = "token accepted" },
                .{ .key = "identity.cursor_round_trip", .event = "cursor refused" },
                .{ .key = "identity.cursor_round_trip", .event = "cursor accepted" },
                .{ .key = "identity.cursor_canonical", .event = "cursor accepted" },
                .{ .key = "identity.scoped_cursor", .event = "cursor accepted" },
                .{ .key = "http.decimal", .event = "accepted" },
                .{ .key = "text.grapheme_tiling", .event = "more than one cluster" },
                .{ .key = "text.grapheme_tiling", .event = "a cluster joins code points" },
                .{ .key = "text.grapheme_model", .event = "three flags in a row" },
                .{ .key = "text.grapheme_model", .event = "emoji zwj sequence" },
                .{ .key = "text.uri", .event = "uri accepted" },
                .{ .key = "records.track_model", .event = "record accepted" },
                .{ .key = "records.jetstream_json", .event = "json verified" },
                .{ .key = "records.jetstream_json", .event = "tampered cid refused" },
                .{ .key = "pagination.tracks", .event = "more than one page" },
                .{ .key = "pagination.tracks", .event = "timestamp tie" },
                .{ .key = "pagination.targets", .event = "found" },
                .{ .key = "await.schedule", .event = "timed out" },
                .{ .key = "await.schedule", .event = "settled record seen" },
                .{ .key = "health.ingest_view", .event = "checkpoint rendered" },
                .{ .key = "jams.transition", .event = "applied" },
                .{ .key = "jams.references", .event = "accepted" },
                .{ .key = "jams.references", .event = "too many tracks" },
                .{ .key = "jams.references", .event = "refused: id_mismatch" },
                .{ .key = "jams.references", .event = "refused: raw_codec" },
                .{ .key = "jams.references", .event = "refused: too_long" },
                .{ .key = "jams.ticket_token", .event = "well formed" },
                .{ .key = "jams.ticket_token", .event = "malformed" },
            },
        },
        .{
            .name = "stores",
            .root = "next/backend",
            .build = .{ "zig", "build", "install-fuzz", "-Dhegel", "-Doptimize=ReleaseSafe" },
            .command = .{"zig-out/bin/fuzz"},
            .seeds = .{ 1, 2 },
            .cases = 200,
            .timeout_seconds = 900,
            .env = .{ .{ .name = "PLYR_ZIG_TEST_DATABASE_URL", .value = "postgresql://zig_test:zig_test@127.0.0.1:5435/zig_test" }, .{ .name = "FUZZ_ONLY", .value = "like_counts,projector" } },
            .reach = .{
                .{ .key = "like_counts.triggers", .event = "a statement changes several likes" },
                .{ .key = "like_counts.triggers", .event = "an account with likes goes unavailable" },
                .{ .key = "like_counts.triggers", .event = "a subject counts more than one liker" },
                .{ .key = "projector.commits_match_snapshot", .event = "a commit rewrites an existing record" },
                .{ .key = "projector.commits_match_snapshot", .event = "the chain ends with an empty repository" },
            },
        },
        .{
            .name = "calibration",
            .root = "next/backend",
            .build = .{ "zig", "build", "install-fuzz", "-Dhegel", "-Doptimize=ReleaseSafe" },
            .command = .{"zig-out/bin/fuzz"},
            .seeds = .{ 1, 2, 3 },
            .cases = 500,
            .timeout_seconds = 900,
            .env = .{.{ .name = "PLYR_ZIG_TEST_DATABASE_URL", .value = "postgresql://zig_test:zig_test@127.0.0.1:5435/zig_test" }},
            .mutants = "src/fuzz/mutants.zon",
            .reach = .{
                .{ .key = "identity.id_round_trip", .event = "uri refused" },
                .{ .key = "identity.id_round_trip", .event = "uri accepted" },
                .{ .key = "identity.id_canonical", .event = "token accepted" },
                .{ .key = "identity.cursor_round_trip", .event = "cursor refused" },
                .{ .key = "identity.cursor_round_trip", .event = "cursor accepted" },
                .{ .key = "identity.cursor_canonical", .event = "cursor accepted" },
                .{ .key = "identity.scoped_cursor", .event = "cursor accepted" },
                .{ .key = "http.decimal", .event = "accepted" },
                .{ .key = "text.grapheme_tiling", .event = "more than one cluster" },
                .{ .key = "text.grapheme_tiling", .event = "a cluster joins code points" },
                .{ .key = "text.grapheme_model", .event = "three flags in a row" },
                .{ .key = "text.grapheme_model", .event = "emoji zwj sequence" },
                .{ .key = "text.uri", .event = "uri accepted" },
                .{ .key = "records.track_model", .event = "record accepted" },
                .{ .key = "records.jetstream_json", .event = "json verified" },
                .{ .key = "records.jetstream_json", .event = "tampered cid refused" },
                .{ .key = "pagination.tracks", .event = "more than one page" },
                .{ .key = "pagination.tracks", .event = "timestamp tie" },
                .{ .key = "pagination.targets", .event = "found" },
                .{ .key = "await.schedule", .event = "timed out" },
                .{ .key = "await.schedule", .event = "settled record seen" },
                .{ .key = "health.ingest_view", .event = "checkpoint rendered" },
                .{ .key = "jams.transition", .event = "applied" },
                .{ .key = "jams.references", .event = "accepted" },
                .{ .key = "jams.references", .event = "too many tracks" },
                .{ .key = "jams.references", .event = "refused: id_mismatch" },
                .{ .key = "jams.references", .event = "refused: raw_codec" },
                .{ .key = "jams.references", .event = "refused: too_long" },
                .{ .key = "jams.ticket_token", .event = "well formed" },
                .{ .key = "jams.ticket_token", .event = "malformed" },
                .{ .key = "like_counts.triggers", .event = "a statement changes several likes" },
                .{ .key = "like_counts.triggers", .event = "an account with likes goes unavailable" },
                .{ .key = "like_counts.triggers", .event = "a subject counts more than one liker" },
                .{ .key = "projector.commits_match_snapshot", .event = "a commit rewrites an existing record" },
                .{ .key = "projector.commits_match_snapshot", .event = "the chain ends with an empty repository" },
            },
        },
    },
}
