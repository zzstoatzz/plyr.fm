{
  "expo": {
    "name": "plyr.fm",
    "slug": "plyr-fm",
    "owner": "zzstoatzz.io",
    "scheme": "fm.plyr.next",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "fm.plyr",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fm.plyr.next"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": "SUBQUERY(extensionItems, $extensionItem, SUBQUERY($extensionItem.attachments, $attachment, ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.audio\").@count == 1).@count == 1",
            "extensionBundleIdentifier": "fm.plyr.share"
          },
          "android": {
            "enabled": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "plyr.fm opens your photos so you can pick cover art.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/share-extension-name"
    ],
    "extra": {
      "eas": {
        "projectId": "680fd924-087f-4ae5-8813-2fee71cb66f8"
      }
    }
  }
}
