{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "phosphor-react-native/src/icons/*": [
        "./node_modules/phosphor-react-native/lib/typescript/index.d.ts"
      ]
    }
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "scripts/**/*.mts",
    "index.js",
    "metro.config.js"
  ]
}
