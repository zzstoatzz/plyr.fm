#!/bin/sh
set -eu

expected_branch='codex/zig-backend'
actual_branch=$(git branch --show-current)
if [ "$actual_branch" != "$expected_branch" ]; then
    echo "refusing next deployment from $actual_branch" >&2
    exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
    echo 'refusing next deployment from a dirty worktree' >&2
    exit 1
fi

commit_hash=$(git rev-parse HEAD)
commit_message=$(git log -1 --pretty=%s)
exec bunx wrangler pages deploy public \
    --project-name plyr-fm-next \
    --branch "$expected_branch" \
    --commit-hash "$commit_hash" \
    --commit-message "$commit_message" \
    --commit-dirty=false
