# Zig backend development commands.
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set positional-arguments := true

default: check

build:
    zig build

image:
    docker build --platform linux/amd64 --tag plyr-backend-zig:canary .

run:
    MODE=api TRACK_COLLECTION_NSID=${TRACK_COLLECTION_NSID:?set TRACK_COLLECTION_NSID} LIST_COLLECTION_NSID=${LIST_COLLECTION_NSID:?set LIST_COLLECTION_NSID} PROFILE_COLLECTION_NSID=${PROFILE_COLLECTION_NSID:?set PROFILE_COLLECTION_NSID} zig build run

# Authenticates and atomically reconciles one repository into the configured DB.
repair-repo DID:
    MODE=repair INDEX_MODE=required INGEST_REPAIR_DID={{ DID }} TRACK_COLLECTION_NSID=${TRACK_COLLECTION_NSID:?set TRACK_COLLECTION_NSID} LIST_COLLECTION_NSID=${LIST_COLLECTION_NSID:?set LIST_COLLECTION_NSID} PROFILE_COLLECTION_NSID=${PROFILE_COLLECTION_NSID:?set PROFILE_COLLECTION_NSID} DATABASE_URL=${DATABASE_URL:?set DATABASE_URL} zig build run

# Runs the separately supervised continuous signed-relay consumer.
ingest:
    MODE=ingester INDEX_MODE=required TRACK_COLLECTION_NSID=${TRACK_COLLECTION_NSID:?set TRACK_COLLECTION_NSID} LIST_COLLECTION_NSID=${LIST_COLLECTION_NSID:?set LIST_COLLECTION_NSID} PROFILE_COLLECTION_NSID=${PROFILE_COLLECTION_NSID:?set PROFILE_COLLECTION_NSID} DATABASE_URL=${DATABASE_URL:?set DATABASE_URL} zig build run

# Reconciles canonical account availability without blocking relay ingestion.
reconcile-accounts:
    MODE=account_reconciler INDEX_MODE=required TRACK_COLLECTION_NSID=${TRACK_COLLECTION_NSID:?set TRACK_COLLECTION_NSID} LIST_COLLECTION_NSID=${LIST_COLLECTION_NSID:?set LIST_COLLECTION_NSID} PROFILE_COLLECTION_NSID=${PROFILE_COLLECTION_NSID:?set PROFILE_COLLECTION_NSID} DATABASE_URL=${DATABASE_URL:?set DATABASE_URL} zig build run

test:
    zig build test

check:
    zig fmt --check build.zig src
    zig build
    zig build test
    python3 scripts/test_http.py
    cd ../backend && uv run ruff check ../backend-zig/scripts

# Destructive only to the dedicated Docker test database on port 5433.
test-postgres:
    docker compose -f ../backend/tests/docker-compose.yml up -d test-db
    @for attempt in {1..100}; do docker compose -f ../backend/tests/docker-compose.yml exec -T test-db pg_isready -U relay_test -d relay_test >/dev/null && exit 0; sleep 0.1; done; echo 'test Postgres did not become ready' >&2; exit 1
    PLYR_ZIG_TEST_DATABASE_URL=postgresql://relay_test:relay_test@127.0.0.1:5433/relay_test zig build test
    cd ../backend && DATABASE_URL=postgresql://relay_test:relay_test@127.0.0.1:5433/relay_test RELAY_TEST_MODE=1 OAUTH_ENCRYPTION_KEY=hnSkDmgbbuK0rt7Ab3eJHAktb18gmebsdwKdTmq9mes= uv run python ../backend-zig/scripts/test_list_migration.py

test-http: build
    python3 scripts/test_http.py

bench-http *ARGS:
    zig build -Doptimize=ReleaseFast
    python3 scripts/bench_http.py "$@"

# Destructive only to the dedicated Docker test database on port 5433.
bench-album-detail:
    docker compose -f ../backend/tests/docker-compose.yml up -d test-db
    @for attempt in {1..100}; do docker compose -f ../backend/tests/docker-compose.yml exec -T test-db pg_isready -U relay_test -d relay_test >/dev/null && break; sleep 0.1; done
    docker compose -f ../backend/tests/docker-compose.yml exec -T test-db psql -v ON_ERROR_STOP=1 -U relay_test -d relay_test < scripts/album_detail_bench.sql
    zig build -Doptimize=ReleaseFast
    DATABASE_URL=postgresql://relay_test:relay_test@127.0.0.1:5433/relay_test python3 scripts/bench_http.py --with-index --duration 5 --concurrency 1 --path '/v1/albums/alb_YXQ6Ly9kaWQ6cGxjOmJlbmNoL2ZtLnBseXIuZGV2Lmxpc3QvYWxidW0'
    DATABASE_URL=postgresql://relay_test:relay_test@127.0.0.1:5433/relay_test python3 scripts/bench_http.py --with-index --duration 5 --concurrency 16 --path '/v1/albums/alb_YXQ6Ly9kaWQ6cGxjOmJlbmNoL2ZtLnBseXIuZGV2Lmxpc3QvYWxidW0'

bench-snapshot:
    zig build bench-snapshot -Doptimize=ReleaseFast

bench-ingest-dispatch:
    zig build bench-ingest-dispatch -Doptimize=ReleaseFast

# Snapshot the Python surface that informs parity decisions.
inventory *ARGS:
    cd ../backend && RELAY_TEST_MODE=1 OAUTH_ENCRYPTION_KEY=hnSkDmgbbuK0rt7Ab3eJHAktb18gmebsdwKdTmq9mes= LOGFIRE_IGNORE_NO_CONFIG=1 uv run python ../backend-zig/scripts/inventory_python_api.py "$@"
